<?xml version="1.0" encoding="UTF-8"?>
<!--
  cimicode-bridge - AgentTeams cimicode Worker 桥（Java 版）

  完整 Worker 桥：Matrix 收发 + OpenSandbox 生命周期编排 +
  sessionID<->sandboxID 映射 + cimicode /session/context_prompt SSE 消费。
  架构规格见 wiki/cimicode-runtime-integration.md。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>io.agentteams</groupId>
    <artifactId>cimicode-bridge</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>cimicode-bridge</name>
    <description>AgentTeams cimicode Worker bridge (Matrix &lt;-&gt; stateless cimicode + OpenSandbox)</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>cimicode-bridge</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
