  <diagram id="p6-ov" name="controller-overview">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ov-title" value="AgentTeams Controller 调和层全览（internal/controller）" style="text;html=0;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=20;fontStyle=1;fontColor=#2D3748;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="1000" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ov-src1" value="CR 事件：Worker / Team / Manager / Human" style="rounded=1;whiteSpace=wrap;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ov-src2" value="Watch：Pod / Sandbox / SandboxClaim" style="rounded=1;whiteSpace=wrap;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="70" width="340" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ov-src3" value="Worker status 变化 → 对应 Team 重调和" style="rounded=1;whiteSpace=wrap;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="70" width="340" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ov-src4" value="定时 ticker：AutoSleep（默认 1m）" style="rounded=1;whiteSpace=wrap;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1170" y="70" width="390" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ov-w-rec" value="WorkerReconciler&#xa;worker_controller.go" style="rounded=1;whiteSpace=wrap;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ov-t-rec" value="TeamReconciler&#xa;team_controller.go" style="rounded=1;whiteSpace=wrap;fillColor=#7C3AED;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="170" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ov-m-rec" value="ManagerReconciler&#xa;manager_controller.go" style="rounded=1;whiteSpace=wrap;fillColor=#E99151;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="170" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ov-h-rec" value="HumanReconciler&#xa;human_controller.go" style="rounded=1;whiteSpace=wrap;fillColor=#4CA497;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="170" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ov-a-rec" value="AutoSleepController&#xa;auto_sleep_controller.go" style="rounded=1;whiteSpace=wrap;fillColor=#94A3B8;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1320" y="170" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ov-w-ph" value="reconcileNormal 主链：&#xa;Infra → ModelAuth → SA → Config →&#xa;Container → Service → Expose →&#xa;ManagerAccess&#xa;Edge 轻量分支；被 Team 引用时删除被阻塞" style="rounded=1;whiteSpace=wrap;fillColor=#E99151;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="280" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="ov-t-ph" value="reconcileTeam 7 步：&#xa;① validate ② resolve ③ adminActor&#xa;④ 基础设施 ⑤ 协作上下文+心跳&#xa;⑥ 通道策略★ ⑦ 状态聚合" style="rounded=1;whiteSpace=wrap;fillColor=#7C3AED;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="280" width="280" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="ov-m-ph" value="reconcileManagerNormal：&#xa;Infra → 授权 → SA → Config →&#xa;Container → Welcome&#xa;spec-hash 判定容器重建" style="rounded=1;whiteSpace=wrap;fillColor=#E99151;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="280" width="280" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="ov-h-ph" value="reconcileHumanNormal：&#xa;resolveScope（身份固化）→&#xa;Infra（稳态零 Login）→&#xa;Rooms（invite/join/kick）" style="rounded=1;whiteSpace=wrap;fillColor=#4CA497;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="280" width="280" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="ov-a-ph" value="定时扫描：&#xa;Running + idleTimeout 超时&#xa;→ spec.state=Sleeping&#xa;→ 触发 Worker 重调和" style="rounded=1;whiteSpace=wrap;fillColor=#94A3B8;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1320" y="280" width="240" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="ov-shared" value="共享成员层：member_reconcile.go（Worker / Team 共用）" style="rounded=1;dashed=1;strokeWidth=2;strokeColor=#005D7B;fillColor=none;fontColor=#005D7B;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=14;fontStyle=1;verticalAlign=top;html=1;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="300" y="500" width="620" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="ov-shared-list" value="ReconcileMemberInfra（Matrix/网关/MinIO/房间）&#xa;EnsureModelProviderAuth → EnsureMemberServiceAccount&#xa;ReconcileMemberConfig（openclaw.json | runtime.yaml）&#xa;ReconcileMemberContainer（Running/Sleeping/Stopped + 后端切换）&#xa;ReconcileMemberService → Expose → Delete" style="rounded=1;whiteSpace=wrap;fillColor=#94A3B8;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=13;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="545" width="580" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="ov-svc" value="member_reconcile_service.go&#xa;ReconcileMemberService：K8s ClusterIP Service" style="rounded=1;whiteSpace=wrap;fillColor=#64748B;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="500" width="300" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ov-pat" value="通用模式（所有调和器共用）" style="rounded=1;dashed=1;strokeWidth=2;strokeColor=#005D7B;fillColor=none;fontColor=#005D7B;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=14;fontStyle=1;verticalAlign=top;html=1;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1180" y="500" width="380" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="ov-pat-list" value="finalizer：agentteams.io/cleanup 双态&#xa;scope + defer 统一 Status().Patch&#xa;（ObservedGeneration 防抖）&#xa;Metrics.Observe(kind, start, err)&#xa;分阶段幂等 + Requeue（5m / 30s / 5s）&#xa;mergeLabels 四层优先级 / mergeUserEnv&#xa;多实例隔离：agentteams.io/controller 标签" style="rounded=1;whiteSpace=wrap;fillColor=#94A3B8;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=13;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1200" y="545" width="340" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="ov-out1" value="MinIO：agents/&lt;worker&gt;/openclaw.json&#xa;channels.matrix.* 允许列表" style="shape=cylinder3;whiteSpace=wrap;fillColor=#7C3AED;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ov-out2" value="MinIO：agents/&lt;worker&gt;/runtime/runtime.yaml&#xa;（QwenPaw / CoPaw / Edge）" style="shape=cylinder3;whiteSpace=wrap;fillColor=#64748B;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="760" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ov-out3" value="K8s：Pod / Sandbox /&#xa;Service / ServiceAccount" style="rounded=1;whiteSpace=wrap;fillColor=#4CA497;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="760" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ov-out4" value="CR Status：Phase / MatrixUserID /&#xa;RoomID / SpecHash / ObservedGeneration" style="rounded=1;whiteSpace=wrap;fillColor=#005D7B;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="760" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ov-note1" value="Team 引用式编排：&#xa;删除 Team 只回退（detachTeamMember）不销毁 Worker；&#xa;Worker 仍被 Team 引用时，删除被阻塞" style="rounded=1;whiteSpace=wrap;fillColor=#94A3B8;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=13;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="500" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="ov-note2" value="Human 无容器/无网关 consumer：&#xa;只有 Matrix 身份 + 房间成员关系；&#xa;稳态零 Login（防孤儿设备膨胀）" style="rounded=1;whiteSpace=wrap;fillColor=#94A3B8;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=13;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="580" y="900" width="500" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="ov-note3" value="openclaw.json 允许列表：&#xa;Team 注入 + preserveChannelMatrixAllowFrom 保护&#xa;→ 详见 channel-policy-flow / allowlist-write-path 页" style="rounded=1;whiteSpace=wrap;fillColor=#64748B;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=13;shadow=0;" vertex="1" parent="1">
