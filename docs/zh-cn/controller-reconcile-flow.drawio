  <diagram name="channel-policy-flow" id="channel-policy-flow">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="980" math="0" shadow="0" background="#F8FAFC">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p-title" value="Matrix 通道策略（允许列表）计算与注入流程" style="text;html=0;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=20;fontStyle=1;fontColor=#2D3748;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="600" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p0" value="输入：Team CR + 成员 Worker CR&#xa;+ ManagerConfig + SystemAdminUser" style="rounded=1;whiteSpace=wrap;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="runtime = qwenpaw?" style="rhombus;whiteSpace=wrap;fillColor=#005D7B;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="170" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="pskip" value="跳过：QwenPaw 走 runtime.yaml&#xa;（deployTeamRuntimeConfigs），不注入 openclaw.json 策略" style="rounded=1;whiteSpace=wrap;fillColor=#94A3B8;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="170" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="成员角色 role = ?" style="rhombus;whiteSpace=wrap;fillColor=#005D7B;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="300" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p3w" value="Worker 允许列表&#xa;group/dm = [leader, systemAdmin, coordinators…, peers?]&#xa;（PeerMentions=false 时不含 peers）" style="rounded=1;whiteSpace=wrap;fillColor=#E99151;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p3l" value="Leader 允许列表&#xa;group/dm = [manager, systemAdmin, coordinators…, 全部成员]" style="rounded=1;whiteSpace=wrap;fillColor=#E99151;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="420" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="mergeChannelPolicy&#xa;（团队级 ChannelPolicy + Worker 个体 ChannelPolicy）" style="rounded=1;whiteSpace=wrap;fillColor=#7C3AED;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="560" width="360" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p5" value="applyChannelAllowPolicy&#xa;（GroupAllow/DenyExtra、DmAllow/DenyExtra）" style="rounded=1;whiteSpace=wrap;fillColor=#7C3AED;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="650" width="360" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p6" value="uniqueTeamStrings 去重去空" style="rounded=1;whiteSpace=wrap;fillColor=#E99151;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="740" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p7" value="Deployer.InjectChannelPolicy&#xa;原地写回 MinIO agents/&lt;worker&gt;/openclaw.json&#xa;（channels.matrix.groupAllowFrom + dm.allowFrom）" style="rounded=1;whiteSpace=wrap;fillColor=#005D7B;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="830" width="360" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p8" value="Manager 侧同步：&#xa;UpdateManagerGroupAllowFrom(leader=true; worker=false)&#xa;+ ForceLeaveRoom(普通 Worker 个人房间移除 Manager)" style="rounded=1;whiteSpace=wrap;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="830" width="360" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p9" value="保护机制：preserveChannelMatrixAllowFrom&#xa;Worker 侧重生成 openclaw.json 时，从旧文件拷回团队列表，&#xa;不回退成独立 [manager, admin]" style="rounded=1;whiteSpace=wrap;fillColor=#64748B;strokeColor=none;fontColor=#FFFFFF;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="120" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="pe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;strokeWidth=2;strokeColor=#94A3B8;" edge="1" source="p0" target="p1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pe2" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;strokeWidth=2;strokeColor=#94A3B8;labelBackgroundColor=#F8FAFC;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=15;fontColor=#64748B;" edge="1" source="p1" target="pskip" parent="1">
